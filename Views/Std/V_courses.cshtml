@model IEnumerable<Student.Models.Course>

@{
    ViewData["Title"] = "Available Courses";
}

<div class="container mt-4">
    <h2>Available Courses</h2>
    <hr />

    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@course.Name</h5>
                        <p class="card-text">@course.Description</p>
                        <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-info btn-sm">Details</a>
                       <form asp-controller="Std" asp-action="Enroll" method="post" class="d-inline">
                            <input type="hidden" name="courseId" value="@course.Id" />
                            <button type="submit" class="btn btn-success btn-sm">Enroll</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
 <div class="mt-3">
    <a asp-action="MyCourses" class="btn btn-secondary">Go to Your Courses</a>
</div>